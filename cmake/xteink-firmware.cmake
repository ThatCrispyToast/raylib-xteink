include(${CMAKE_CURRENT_LIST_DIR}/raylib-x4.cmake)
if(XTEINK_DEVICE STREQUAL "x4" OR XTEINK_DEVICE STREQUAL "x3")
    set(XTEINK_IDF_TARGET esp32c3)
else()
    set(XTEINK_IDF_TARGET esp32s3)
endif()
if(DEFINED IDF_TARGET AND NOT IDF_TARGET STREQUAL XTEINK_IDF_TARGET)
    message(FATAL_ERROR "${XTEINK_DEVICE} requires IDF_TARGET=${XTEINK_IDF_TARGET}; use a separate build directory")
endif()
set(IDF_TARGET ${XTEINK_IDF_TARGET})
if(NOT DEFINED XTEINK_PANEL)
    if(XTEINK_DEVICE STREQUAL "x3")
        set(XTEINK_PANEL uc8253)
    else()
        set(XTEINK_PANEL ssd1677)
    endif()
endif()
set(XTEINK_PANEL "${XTEINK_PANEL}" CACHE STRING "Panel controller; verify the device's panel variant")
set_property(CACHE XTEINK_PANEL PROPERTY STRINGS ssd1677 uc8253 uc8179 uc8279)
if(XTEINK_DEVICE STREQUAL "x4")
    set(_panels ssd1677)
elseif(XTEINK_DEVICE STREQUAL "x3")
    set(_panels uc8253 uc8279)
else()
    set(_panels ssd1677 uc8179 uc8279)
endif()
if(NOT XTEINK_PANEL IN_LIST _panels)
    message(FATAL_ERROR "Incompatible XTEINK_PANEL=${XTEINK_PANEL} for ${XTEINK_DEVICE}; choose ${_panels}")
endif()
if(XTEINK_PANEL STREQUAL "ssd1677")
    set(XTEINK_PANEL_DEFINE "XTEINK_PANEL=XTEINK_SSD1677")
else()
    string(TOUPPER "${XTEINK_PANEL}" _panel)
    set(XTEINK_PANEL_DEFINE "XTEINK_PANEL=XTEINK_PANEL_${_panel}")
endif()
