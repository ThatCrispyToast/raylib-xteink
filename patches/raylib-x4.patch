+void swGetTexImage(SWformat format, SWtype type, void *pixels)
+{
+    sw_texture_t *texture = RLSW.boundTexture;
+    if (!sw_is_texture_complete(texture) || !pixels)
+    { RLSW.errCode = SW_INVALID_VALUE; return; }
+    sw_pixelformat_t destination = sw_pixel_get_format(format, type);
+    if (destination <= SW_PIXELFORMAT_UNKNOWN || !texture->readColor)
+    { RLSW.errCode = SW_INVALID_ENUM; return; }
+    if (destination == texture->format)
+    {
+        memcpy(pixels, texture->pixels, texture->width*texture->height*SW_PIXELFORMAT_SIZE[destination]);
+        return;
+    }
+    sw_pixel_write_color_f writeColor = sw_pixel_get_write_color_func(destination);
+    if (!writeColor) { RLSW.errCode = SW_INVALID_ENUM; return; }
+    for (int i = 0; i < texture->width*texture->height; i++)
+    {
+        float color[4];
+        texture->readColor(color, texture->pixels, i);
+        writeColor(pixels, color, i);
+    }
+}
